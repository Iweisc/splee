DATABASE_URL=postgres://splee:splee@127.0.0.1:55432/splee
# Fine for local dev. Replace it before going live: the API refuses it when PUBLIC_URL is https.
APP_SECRET=dev-only-change-me-0123456789abcdef
PUBLIC_URL=http://localhost:3333
API_URL=http://localhost:8787
BIND_ADDR=127.0.0.1:8787
AGENT_MODEL=claude-sonnet-5-5
AGENT_CONCURRENCY=2
# Set to false on a test backend that shares a database with live campaigns. Approved emails then wait.
# SENDING_ENABLED=false
RUST_LOG=splee=debug,tower_http=info
# Set to false to make sign-up invite-only after the first account.
# OPEN_SIGNUP=false
# Comma-separated emails that can load countries into the company database from the Companies page.
# OPERATOR_EMAILS=you@example.com
# Set to false to turn off the demo, company explorer and support chat for signed-out visitors.
# PUBLIC_AGENT=false
# Lets research runs search and read X through the bird CLI. Leave unset to turn it off.
# BIRD_BIN=bird
# OAuth apps for connecting Gmail and Outlook mailboxes by signing in. The README says how to register them.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# The Tumblr app projects connect Tumblr through. The README says how to register it.
# TUMBLR_CLIENT_ID=
# TUMBLR_CLIENT_SECRET=
# The Meta app projects sign in with Facebook through, for their Pages and Instagram accounts. Its redirect URL is PUBLIC_URL
# + /api/social/oauth/meta/callback. GRAPH_API_URL is only for tests and sandboxes, which point it at a fake.
# META_APP_ID=
# META_APP_SECRET=
# GRAPH_API_URL=https://graph.facebook.com/v21.0
# The Salesforce connected app and Zoho client projects connect those CRMs through. Dynamics 365 Sales uses the Microsoft app
# above. The README says how to register them.
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# Looks up the companies behind website visitors' IPs. Without it, Splee uses reverse DNS and RDAP.
# IPINFO_TOKEN=
